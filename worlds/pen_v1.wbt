#VRML_SIM R2023b utf8

WorldInfo {
  basicTimeStep 32
}
Viewpoint {
  position 0 0.55 0.65
  orientation -0.42 0.9 0.18 0.95
  description "Top view of autonomous pen"
}
TexturedBackground {
  texture "sky"
}
TexturedBackgroundLight {
}
Floor {
  size 0.32 0.24
  appearance PBRAppearance {
    baseColor 0.92 0.92 0.92
    roughness 0.9
  }
}

Robot {
  name "AI_PEN_V1"
  supervisor TRUE
  controller "pen_omni_test"
  translation 0 0.012 0

  children [
    # Main rounded/triangular visual body
    Shape {
      appearance PBRAppearance {
        baseColor 0.18 0.18 0.20
        roughness 0.55
      }
      geometry IndexedFaceSet {
        coord Coordinate {
          point [
            0 0.020 0.038
            -0.040 0.020 -0.028
            0.040 0.020 -0.028
            0 0.020 0.010
            0 0.000 0.038
            -0.040 0.000 -0.028
            0.040 0.000 -0.028
            0 0.000 0.010
          ]
        }
        coordIndex [
          0 1 2 -1
          4 6 5 -1
          0 4 5 1 -1
          0 2 6 4 -1
          1 5 6 2 -1
          3 7 6 2 -1
          3 0 4 7 -1
          3 1 5 7 -1
          3 2 1 -1
        ]
      }
    }

    # Pen tip at the geometric center
    Transform {
      translation 0 0.0 0
      children [
        Shape {
          appearance PBRAppearance {
            baseColor 0.05 0.05 0.05
            roughness 0.7
          }
          geometry Cylinder {
            radius 0.002
            height 0.018
          }
        }
      ]
    }

    # Three omni-wheel visual placeholders, 120 degrees apart
    Transform {
      translation 0.042 0.006 -0.024
      rotation 0 0 1 1.0472
      children [
        Shape {
          appearance PBRAppearance {
            baseColor 0.08 0.08 0.08
            roughness 0.8
          }
          geometry Cylinder {
            radius 0.010
            height 0.006
          }
        }
      ]
    }
    Transform {
      translation -0.042 0.006 -0.024
      rotation 0 0 1 -1.0472
      children [
        Shape {
          appearance PBRAppearance {
            baseColor 0.08 0.08 0.08
            roughness 0.8
          }
          geometry Cylinder {
            radius 0.010
            height 0.006
          }
        }
      ]
    }
    Transform {
      translation 0 0.006 0.045
      rotation 1 0 0 1.5708
      children [
        Shape {
          appearance PBRAppearance {
            baseColor 0.08 0.08 0.08
            roughness 0.8
          }
          geometry Cylinder {
            radius 0.010
            height 0.006
          }
        }
      ]
    ]

    # Marker for the pen tip position
    Shape {
      appearance PBRAppearance {
        baseColor 0.85 0.15 0.15
        roughness 0.5
      }
      geometry Sphere {
        radius 0.0035
      }
    }
  ]
}
